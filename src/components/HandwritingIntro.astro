---
import { textToSvg } from 'tegaki/core';
import caveat from 'tegaki/fonts/caveat';

// Caveat's extracted "i" glyph stores the dot before the stem. Swap them so
// the stem is drawn first, the way a hand writes it.
const handwritingFont = structuredClone(caveat);
const iGlyph = handwritingFont.glyphData.i;
const [iDot, iStem] = iGlyph.s;
iGlyph.s = [
  { ...iStem, d: 0 },
  { ...iDot, d: iStem.d + iStem.a },
];

// Caveat's "s" is stored bottom-to-top. Reverse the path so it is written
// from the top down; its old nib stamp no longer lines up, so drop it.
const sGlyph = handwritingFont.glyphData.s;
const sStroke = sGlyph.s[0];
sGlyph.s = [{
  ...sStroke,
  p: [...sStroke.p].reverse(),
  n: undefined,
}];

// Generate the word once at build time: real stroke data, no runtime JS.
const handwriting = textToSvg('Miles', handwritingFont, {
  fontSize: 220,
  mode: 'once',
  color: 'currentColor',
  pressure: 0,
  speed: 0.9,
  timing: { deferDots: false },
});
---

<div class="intro-overlay" data-intro aria-hidden="true">
  <div class="intro-stage">
    <div class="intro-word-wrap">
      <div class="intro-word" aria-hidden="true" set:html={handwriting}></div>
    </div>
    <p class="intro-sub">notes on code, product &amp; life</p>
  </div>
  <button class="intro-skip" type="button" data-intro-skip>跳过</button>
</div>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-intro]');
    if (!overlay) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || sessionStorage.getItem('miles-intro-seen-v3') === '1') return;

    sessionStorage.setItem('miles-intro-seen-v3', '1');
    document.documentElement.classList.add('intro-active');
    requestAnimationFrame(() => overlay.classList.add('is-active'));

    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      overlay.classList.add('is-exiting');
      document.documentElement.classList.remove('intro-active');
      setTimeout(() => overlay.remove(), 700);
    };

    const timer = setTimeout(finish, 3600);
    overlay.querySelector('[data-intro-skip]')?.addEventListener('click', () => {
      clearTimeout(timer);
      finish();
    });
  })();
</script>
