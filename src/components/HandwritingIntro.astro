---
import { textToSvg } from 'tegaki/core';
import caveat from 'tegaki/fonts/caveat';

// Generate the word once at build time: real stroke data, no runtime JS.
const handwriting = textToSvg('welcome', caveat, {
  fontSize: 220,
  mode: 'once',
  color: 'currentColor',
  pressure: 0,
  speed: 2,
  timing: { deferDots: false },
});
---

<div class="intro-overlay" data-intro aria-hidden="true">
  <div class="intro-stage">
    <div class="intro-word-wrap">
      <div class="intro-word" aria-hidden="true" set:html={handwriting}></div>
    </div>
    <p class="intro-sub">notes on code, product &amp; life</p>
  </div>
  <button class="intro-skip" type="button" data-intro-skip>跳过</button>
</div>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-intro]');
    if (!overlay) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || sessionStorage.getItem('miles-intro-seen-v5') === '1') return;

    sessionStorage.setItem('miles-intro-seen-v5', '1');
    document.documentElement.classList.add('intro-active');
    requestAnimationFrame(() => overlay.classList.add('is-active'));

    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      overlay.classList.add('is-exiting');
      document.documentElement.classList.remove('intro-active');
      setTimeout(() => overlay.remove(), 320);
    };

    const timer = setTimeout(finish, 1680);
    overlay.querySelector('[data-intro-skip]')?.addEventListener('click', () => {
      clearTimeout(timer);
      finish();
    });
  })();
</script>
