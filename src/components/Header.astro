---
const path = Astro.url.pathname;
const items = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
const isActive = (href) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="shell nav">
    <a class="brand" href="/" aria-label="Miles Notes 首页">
      <span class="brand-mark">MILES</span>
      <span class="brand-sub">Notes / 个人博客</span>
    </a>

    <nav aria-label="主导航">
      <ul class="nav-links">
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色模式">
      DARK
    </button>
  </div>
</header>
