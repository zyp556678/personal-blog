---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <section class="post-page">
    <div class="shell">
      <article class="post">
        <header class="post-header">
          <div class="post-kicker">
            <span class="accent">随笔 / ESSAY</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span>{readingTime(post)}</span>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </div>
        </header>

        <div class="post-body">
          <Content />
        </div>

        <footer class="post-footer">
          {previous ? <a href={`/blog/${previous.id}/`}>← 上一篇：{previous.data.title}</a> : <span />}
          {next ? <a href={`/blog/${next.id}/`}>下一篇：{next.data.title} →</a> : <span />}
        </footer>
      </article>
    </div>
  </section>
</BaseLayout>
