---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面不存在">
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow">404 <span class="dot">/</span> NOT FOUND</p>
      <h1>这里什么都没有。</h1>
      <p class="page-desc">你访问的页面不存在，或者已经被搬走了。</p>
      <p><a class="section-link" href="/">回到首页 →</a></p>
    </div>
  </section>
</BaseLayout>
