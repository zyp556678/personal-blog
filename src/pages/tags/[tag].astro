---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`Miles Notes 中关于「${tag}」的文章。`}>
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow">Tag <span class="dot">/</span> 标签</p>
      <h1>#{tag}</h1>
      <p class="page-desc">关于「{tag}」的文章，共 {posts.length} 篇。</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0; border-top: 0;">
    <div class="shell">
      <div class="post-list">
        {posts.map((post, index) => <PostRow post={post} index={index + 1} />)}
      </div>
    </div>
  </section>
</BaseLayout>
